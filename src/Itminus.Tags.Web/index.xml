	<!-- ZLan 配置 -->
	<TagGrp name="g2" isEntry="true" isEnabled="false" channel="ZLan-1" scanInterval="10">
		<TagCbnt name="输入" area="DI" access="RO">
			<Tag name="放行按钮闭合状态" address="DI1" type="DI"></Tag>
			<Tag name="手动" address="DI2" type="DI"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" area="DO" access="R1W">
			<Tag name="绿灯" address="DO1" type="DO"></Tag>
			<Tag name="红灯" address="DO2" type="DO"></Tag>
			<Tag name="黄灯" address="DO3" type="DO"></Tag>
			<Tag name="放行灯" address="DO4" type="DO"></Tag>
		</TagCbnt>
	</TagGrp>

	<!-- ModbusTcp 配置 -->
	<TagGrp name="g3" isEntry="true" isEnabled="false" channel="ModbusTcp-2" scanInterval="10">
		<TagCbnt name="输入" address="10001" access="RO">
			<Tag name="放行按钮闭合状态" address="10001" type="DI"></Tag>
			<Tag name="手动" address="10002" type="DI"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" address="00001" access="R1W">
			<Tag name="绿灯" address="00020" type="DO"></Tag>
			<Tag name="红灯" address="00021" type="DO"></Tag>
			<Tag name="黄灯" address="00022" type="DO"></Tag>
			<Tag name="放行灯" address="00023" type="DO"></Tag>
		</TagCbnt>
		<TagCbnt name="采集" address="40001" access="RO">
			<Tag name="byte" address="40020" type="BYTE"></Tag>
			<Tag name="int16" address="40021" type="INT16"></Tag>
			<Tag name="int32" address="40022" type="INT32"></Tag>
			<Tag name="float" address="40024" type="FLOAT"></Tag>
		</TagCbnt>
	</TagGrp>

	<!-- OpcUa 配置 -->
	<TagGrp name="g4" isEntry="true" isEnabled="false" channel="OpcUaClient-2" scanInterval="10">
		<TagCbnt name="输入" access="RO">
			<Tag name="放行按钮闭合状态" address="ns=4;s=|var|CODESYS Control Win V3 x64.Application.PLC_PRG.var3" ></Tag>
			<Tag name="手动" address="ns=4;s=|var|CODESYS Control Win V3 x64.Application.PLC_PRG.var3"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" >
			<Tag name="绿灯" address="ns=4;s=|var|CODESYS Control Win V3 x64.Application.PLC_PRG.var3"></Tag>
			<Tag name="红灯" address="ns=4;s=|var|CODESYS Control Win V3 x64.Application.PLC_PRG.var4"></Tag>
			<Tag name="黄灯" address="ns=4;s=|var|CODESYS Control Win V3 x64.Application.PLC_PRG.var5"></Tag>
			<Tag name="放行灯" address="ns=4;s=|var|CODESYS Control Win V3 x64.Application.PLC_PRG.var6"></Tag>
		</TagCbnt>
	</TagGrp>



	<TagGrp name="拧紧枪" isEntry="true"  isEnabled="false" channel="S7-1" scanInterval="10">

		<TagGrp name="1#">
			<TagCbnt name="拧紧请求" address="DB400.0" access="RW">
				<Tag name="请求标志" address="DB400.0.0" type="BIT"></Tag>
				<Tag name="程序号" address="DB400.2" type="INT16"></Tag>
				<Tag name="套筒号" address="DB400.4" type="INT16"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧响应" address="DB500.0" access="RW">
				<Tag name="响应标志" address="DB500.0.0" type="BIT"></Tag>
			</TagCbnt>
		</TagGrp>

		<TagGrp name="2#">
			<TagCbnt name="拧紧请求" address="DB400.20" access="RW">
				<Tag name="请求标志" address="DB400.20.0" type="BIT"></Tag>
				<Tag name="程序号" address="DB400.22" type="INT16"></Tag>
				<Tag name="套筒号" address="DB400.24" type="INT16"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧响应" address="DB500.20" access="RW">
				<Tag name="响应标志" address="DB500.20.0" type="BIT"></Tag>
			</TagCbnt>
		</TagGrp>

		<TagGrp name="3#">
			<TagCbnt name="拧紧请求" address="DB400.60" access="RW">
				<Tag name="请求标志" address="DB400.60.0" type="BIT"></Tag>
				<Tag name="程序号" address="DB400.62" type="INT16"></Tag>
				<Tag name="套筒号" address="DB400.64" type="INT16"></Tag>
			</TagCbnt>
			<TagCbnt name="拧紧响应" address="DB500.60" access="RW">
				<Tag name="响应标志" address="DB500.60.0" type="BIT"></Tag>
			</TagCbnt>
		</TagGrp>

	</TagGrp>


	<TagGrp name="扫码枪" isEntry="true" isEnabled="true" scanInterval="10">
		<Tag name="1#" type="STR"  channel="COM-1"></Tag>
		<Tag name="2#" type="STR"  channel="COM-2"></Tag>
	</TagGrp>

	<!-- 逻辑配置，可以配置0~N个 -->
