<?xml version="1.0" encoding="utf-8"?>
<root>

	<!-- 通道，可以配置多个-->
	<Channel name="S7-1" driver="S7" >
		<IpAddr>localhost</IpAddr>
		<Rack>0</Rack>
		<Slot>1</Slot>
	</Channel>
	<Channel name="ModbusTcp-2" driver="ModbusTcp">
		<IpAddr>localhost</IpAddr>
		<Port>502</Port>
	</Channel>
	<Channel name="ZLan-1" driver="ZLanTcp">
		<IpAddr>localhost</IpAddr>
		<Port>502</Port>
	</Channel>
	<Channel name="S7-3" driver="S7" >
		<IpAddr>192.168.1.13</IpAddr>
		<Rack>0</Rack>
		<Slot>3</Slot>
	</Channel>
	<Channel name="OpcUaClient-2" driver="OpcUaClient">
		<ClientName>client-name-1</ClientName>
		<ServerOpt>
			<DiscoveryUrl>opc.tcp://DESKTOP-FM4T292:4840</DiscoveryUrl>
			<UsePassword>false</UsePassword>
			<UserName>user</UserName>
			<Password>1</Password>
		</ServerOpt>
	</Channel>
	<Channel name="COM-1" driver="ComScanner">
		<Port>COM1</Port>
		<BaundRate>115200</BaundRate>
		<Parity>None</Parity>
		<DataBits>8</DataBits>
		<StopBits>One</StopBits>
	</Channel>
	<Channel name="COM-2" driver="ComScanner">
		<Port>COM2</Port>
		<BaundRate>115200</BaundRate>
		<Parity>None</Parity>
		<DataBits>8</DataBits>
		<StopBits>One</StopBits>
	</Channel>

