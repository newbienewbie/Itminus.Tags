@using Itminus.Tags.S7
<h3>ChannelEditor</h3>
<MudForm>

	<MudTextField Label="通道名" @bind-Value="Descriptor.Name" 
	Required="true" RequiredError="通道名是必填项"
	Variant="Variant.Text"></MudTextField>

	<MudRadioGroup @bind-Value="Driver" Required="true">
		<MudRadio Value="@("S7")">S7</MudRadio>
		<MudRadio Value="@("ModbusTcp")">ModbusTcp</MudRadio>
		<MudRadio Value="@("ZLan")">ZLan</MudRadio>
	</MudRadioGroup>

	@this.RenderChannelImpl(this.Descriptor)

	<MudPaper>
		<MudButton OnClick="OnSave"
			Variant="Variant.Filled" Color="Color.Secondary">保存</MudButton>
	</MudPaper>

</MudForm>

@code {
	[Parameter]
	public EventCallback<ChannelDescriptor> ChannelUpdated { get; set; }

	[Parameter]
	public ChannelDescriptor Descriptor { get; set; } = new();

	private string _driver = "";
	public string Driver
	{
		get => _driver;
		set {
			this._driver = value;
			this.Descriptor.Driver = value;
			this.OnDriverChanged(value);
		}
	}

	private RenderFragment<ChannelDescriptor> RenderChannelImpl = EmptyChannelEditor;

	private RenderFragment<ChannelDescriptor> BuildS7Editor()
	{
		return descriptor => builder => {
			builder.OpenComponent<S7ChannelEditor>(0);
			builder.AddAttribute(1, nameof(S7ChannelEditor.Descriptor), descriptor);
			builder.CloseComponent();
		};
	}

	private static readonly RenderFragment<ChannelDescriptor> EmptyChannelEditor = descriptor => builder => { };


	private void OnDriverChanged(string driver)
	{
		if(driver == "S7")
		{
			this.Descriptor = S7TagChannelDescriptor.FromDescriptor(this.Descriptor);
			this.RenderChannelImpl = BuildS7Editor();
		}
		else{
			this.RenderChannelImpl = EmptyChannelEditor;
		}
		this.InvokeAsync(StateHasChanged);
	}

	public override Task SetParametersAsync(ParameterView parameters)
	{
		if(parameters.TryGetValue<ChannelDescriptor>(nameof(Descriptor), out var d))
		{
			this.Descriptor = d;
		}
		return base.SetParametersAsync(parameters);
	}

	private async void OnSave()
	{
		await this.ChannelUpdated.InvokeAsync(this.Descriptor);
	}

}
