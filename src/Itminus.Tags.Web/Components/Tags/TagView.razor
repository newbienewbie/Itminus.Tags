@using Itminus.Tags.Web.Components.Tags

<div style="display: grid; grid-template-columns: 1fr 3fr 1fr 1fr 3fr; align-items: center; width: 100%">
    <MudText Style="justify-self: start;">@TagName</MudText>
    <MudText Style="justify-self: start;">@TagAddress</MudText>
    <MudText Style="justify-self: start;">@TagKind</MudText>
    <MudText Style="justify-self: start;">@TagSize</MudText>
    <div>
        <MudText Style="justify-self: start;">@Value</MudText>
    </div>

</div>

