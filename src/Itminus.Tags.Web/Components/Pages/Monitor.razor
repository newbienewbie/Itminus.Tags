@using System.Collections.ObjectModel
@using System.Reactive.Linq
@using Itminus.Tags
@using Itminus.Tags.BlazorLib.Components.ChannelDescriptors
@using Itminus.Tags.BlazorLib.Components.Tags
@using Itminus.Tags.Web.Tags

@page "/monitor"
@implements IDisposable
@rendermode InteractiveServer
@inject TagsProjectCtrl projctrl

<PageTitle>Monitor</PageTitle>

<MudButton OnClick="@(async e=>{
    _ = Task.Run(async () =>{
        if(string.IsNullOrEmpty(this.SelectedXml) )
        {
            Console.WriteLine("请选择xml文件");
            
            return;
        }
        await this.projctrl.StartPoll( null, this.SelectedXml);
    });
})">启动</MudButton>

<MudButton OnClick="@(async e=>{
    await this.projctrl.StopAsync();
})">停止</MudButton>

<TagsView RootTag="@RootTag"></TagsView>


<InputSelect  @bind-Value="@SelectedXml">
    <option value="index-plugin.xml">index-plugin.xml</option>
</InputSelect>

@code {
    private IDisposable? _dispose;

    [Parameter]
    public string SelectedXml { get; set; } = "index-plugin.xml";

    protected override Task OnInitializedAsync()
    {
        this.RootTag = this.projctrl.Project?.Tags;

        var startorstopped = Observable.FromEventPattern<TagsProjectStartedOrStopped, TagsProjectEventArgs>(
            h => this.projctrl.StartedOrStopped += h,
            h => this.projctrl.StartedOrStopped -= h
        );
        this._dispose = startorstopped
            .Subscribe(ep =>
            {
                var sender = ep.Sender;
                var args = ep.EventArgs;
                if (args.IsStarted)
                {
                    this.RootTag = this.projctrl.Project?.Tags;
                }
                else
                {
                    this.RootTag = null;
                }
            });


        return base.OnInitializedAsync();
    }


    private ITagGrp? _rootTag;
    public ITagGrp? RootTag { 
        get => _rootTag; 
        set {
            this._rootTag = value;
            this.InvokeAsync(this.StateHasChanged);
        }
    }


    public void Dispose()
    {
        if (this._dispose is not null)
        {
            this._dispose.Dispose();
        }
    }
}
