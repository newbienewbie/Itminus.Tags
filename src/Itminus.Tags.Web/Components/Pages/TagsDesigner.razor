@using Itminus.Tags
@using Itminus.Tags.BlazorLib
@using Itminus.Tags.BlazorLib.Components.Channels
@using Itminus.Tags.Web.Tags
@using System.Xml.Linq
@inject IJSRuntime JS
@inject TagsBlazorLibJsInterop tagsBlazorLibJsInterop

@page "/designer"
@rendermode InteractiveServer
@inject TagsProjectCtrl projctrl

<PageTitle>Designer</PageTitle>

<MudTabs KeepPanelsAlive="true" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">

    <MudTabPanel Text="通道" Icon="@Icons.Material.Filled.AllInclusive">

        <MudPaper Class="pl-4 pb-4 pr-4">
            <div style="display:flex; gap:12px; align-items:center;">
                <TagChannelCreateButton ChannelCreated="OnChannelUpdated" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportProject">导出项目</MudButton>
            </div>
        </MudPaper>

        <h3 Class="mt-8">通道列表</h3>
        <MudPaper Class="pl-4 pb-4 pr-4">
            <TagChannelsView Descriptors="channelDescriptors" Editable="true" />
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="测点" Icon="@Icons.Material.Filled.Tag">
        111
    </MudTabPanel>

</MudTabs>

@code {
    [Parameter]
    public IList<TagChannelDescriptor> channelDescriptors { get; set; } = new List<TagChannelDescriptor>();

    // Placeholder for future tag group descriptors; export will use these when populated.
    [Parameter]
    public IList<TagGrpDescriptor> tagGrpDescriptors { get; set; } = new List<TagGrpDescriptor>();

    private void OnChannelUpdated(TagChannelDescriptor args)
    {
        var found = false;
        for (var i = 0; i < this.channelDescriptors.Count; i++)
        {
            var d = this.channelDescriptors[i];
            if (d.Name == args.Name && d.Driver == args.Driver)
            {
                found = true;
                this.channelDescriptors[i] = args;
                InvokeAsync(StateHasChanged);
                return;
            }
        }
        if (!found)
        {
            this.channelDescriptors.Add(args);
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task ExportProject()
    {
        // Build root document
        var root = new XElement("root");

        // Channels
        foreach (var ch in this.channelDescriptors)
        {
            try
            {
                root.Add(ch.ToXElement());
            }
            catch
            {
                // ignore individual channel export failures
            }
        }

        // Tag groups
        foreach (var grp in this.tagGrpDescriptors)
        {
            try
            {
                root.Add(grp.ToXElement());
            }
            catch
            {
                // ignore individual group export failures
            }
        }

        var doc = new XDocument(new XDeclaration("1.0", "utf-8", "yes"), root);
        var xml = doc.ToString();

        // Use JS to trigger file download

        await tagsBlazorLibJsInterop.DownloadTextFile("index.xml", xml);
        // await JS.InvokeVoidAsync("fileUtil.downloadTextFile", "index.xml", xml);
    }
}
