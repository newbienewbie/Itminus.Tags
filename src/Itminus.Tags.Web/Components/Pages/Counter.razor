@using Itminus.Tags.Web.Components.Channels
@using Itminus.Tags.Web.Components.Tags
@using System.Collections.ObjectModel
@using Itminus.Tags.Projects

@page "/counter"
@rendermode InteractiveServer
@inject ITagsProject proj

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>
<div>
    <TagsView RootTag="@RootTag"></TagsView>
</div>

@code {

    protected override Task OnInitializedAsync()
    {
        this.RootTag = this.proj.Tags;
        return base.OnInitializedAsync();
    }


    private ITagGrp? _rootTag;
    public ITagGrp? RootTag { 
        get => _rootTag; 
        set {
            this._rootTag = value;
            this.InvokeAsync(this.StateHasChanged);
        }
    }

}
