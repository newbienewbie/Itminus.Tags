<?xml version="1.0" encoding="utf-8"?>
<root>
	
	<!-- 通道，可以配置多个-->
    <Channel name="S7-1" driver="S7" >
        <IpAddr>localhost</IpAddr>
        <Rack>0</Rack>
        <Slot>1</Slot>
    </Channel>
    <Channel name="ModbusTcp-2" driver="ModbusTcp">
        <IpAddr>192.168.1.12</IpAddr> 
        <Port>502</Port>
    </Channel>
	<Channel name="ZLan-1" driver="ZLanTcp">
		<IpAddr>localhost</IpAddr>
		<Port>502</Port>
	</Channel>
    <Channel name="S7-3" driver="S7" >
        <IpAddr>192.168.1.13</IpAddr>
        <Rack>0</Rack>
        <Slot>3</Slot>
    </Channel>

	
	<!-- 测点配置，可以配置多个 -->
    <TagGrp name="g1" isEntry="true" isEnabled="true" address="DB200.100.1" channel="S7-1" scanInterval="10">
        <TagCbnt name="拍照请求" access="RO" address="DB200.100.1">
            <Tag name="拍照-请求-标志" address="DB200.100.1" type="BIT" />
            <Tag name="拍照-请求-料号" address="DB200.102" type="BYTE" />
            <Tag name="拍照-请求-程序号" address="DB200.104" type="INT16" />
        </TagCbnt>

        <TagCbnt name="拍照响应" access="R1W" address="DB200.400.0">
            <Tag name="拍照-响应-标志" address="DB200.400.0" type="BIT" />
            <Tag name="拍照-响应-B1" address="DB200.400.1" type="BYTE" />
            <Tag name="拍照-响应-I2" address="DB200.400.2" type="INT16" />
        </TagCbnt>
    </TagGrp>

	<TagGrp name="g2" isEntry="true" isEnabled="true" channel="ZLan-1" scanInterval="10">
		<TagCbnt name="输入" area="DI" access="RO">
			<Tag name="放行按钮闭合状态" address="DI1" type="DI"></Tag>
			<Tag name="手动" address="DI2" type="DI"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" area="DO" access="R1W">
			<Tag name="绿灯" address="DO1" type="DO"></Tag>
			<Tag name="红灯" address="DO2" type="DO"></Tag>
			<Tag name="黄灯" address="DO3" type="DO"></Tag>
			<Tag name="放行灯" address="DO4" type="DO"></Tag>
		</TagCbnt>
	</TagGrp>

	<!-- 逻辑配置，可以配置多个 -->
    <Logicet>E:\SourceCode\揽月\Itminus.Tags\src\Samples.Plugin1\bin\Debug\net8.0\\Samples.Plugin1.dll</Logicet>
</root>