source https://api.nuget.org/v3/index.json
source https://baget.stdunit.com/v3/index.json

cache ./nuget-package-caches
storage: none
strategy: min

nuget FSharp.Core >= 6.0 lowest_matching: true
nuget Itminus.FSharpExtensions >= 0.1.5 lowest_matching: true
nuget FutureTech.ModbusTcp.Options >= 0.5.0
nuget FutureTech.Protocols >= 0.4.2 lowest_matching: true
nuget StdUnit.Sharp7 >= 0.6.0 lowest_matching: true
nuget StdUnit.Sharp7.Options >= 0.6.0 lowest_matching: true
nuget System.Reactive >= 6.0 lowest_matching: true
nuget MudBlazor >= 8.0.0 lowest_matching: true

group Test
    source https://api.nuget.org/v3/index.json
    cache ./nuget-package-caches
    storage: none

    nuget xunit 2.5.3
    nuget xunit.runner.visualstudio 2.5.3
    nuget coverlet.collector 6.0.0
    nuget System.Memory >= 4.5.5 lowest_matching: true
    nuget Microsoft.NET.Test.Sdk 17.8.0


group Build
    source https://api.nuget.org/v3/index.json
    cache ./nuget-package-caches
    storage: none
    strategy: min

	nuget FSharp.Core >= 6.0 lowest_matching: true
    nuget Fake.Core.Target
    nuget Fake.Dotnet.cli
    nuget Fake.DotNet.MSBuild
