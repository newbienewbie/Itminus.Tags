<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Itminus.Tags\Itminus.Tags.csproj" />
  </ItemGroup>

  <!-- 驱动 schema：源生成器编译为常量（TagsGeneratedSchemas），由 ComScannerSchemaProvider 注册进运行期校验；
       NuGet 包经 buildTransitive targets 注入消费项目 Schemas/Drivers/com.xsd。 -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\com.xsd" />
    <ProjectReference Include="..\Itminus.Tags.SchemaGenerator\Itminus.Tags.SchemaGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schemas\Itminus.Tags.ComScanner.targets"
          Pack="true"
          PackagePath="buildTransitive/Itminus.Tags.ComScanner.targets" />
    <None Include="Schemas\com.xsd"
          Pack="true"
          PackagePath="buildTransitive/Schemas/com.xsd" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>