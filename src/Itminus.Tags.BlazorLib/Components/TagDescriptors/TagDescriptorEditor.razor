@using Itminus.Tags
@using MudBlazor

@if (Model is null)
{
    <MudText Typo="Typo.caption">未选中节点</MudText>
}
else
{
    <MudPaper Class="pa-4">
        @if (Model is TagDescriptor td)
        {
            <MudText Typo="Typo.h6">编辑 Tag</MudText>
            <MudTextField Label="Name" @bind-Value="td.TagName" />
            <MudTextField Label="Address" @bind-Value="td.Address" />
            <MudTextField Label="Type" @bind-Value="td.TagKind" />
            <MudTextField Label="Channel" @bind-Value="td.ChannelName" />
            <MudTextField Label="Note" @bind-Value="td.Note" />
            <MudNumericField T="int" Label="TagSize" @bind-Value="td.TagSize" />
            <MudSelect T="TagAccessMode" Label="Access" @bind-Value="td.AccessMode">
                <MudSelectItem Value="TagAccessMode.RW">RW</MudSelectItem>
                <MudSelectItem Value="TagAccessMode.RO">RO</MudSelectItem>
                <MudSelectItem Value="TagAccessMode.R1W">R1W</MudSelectItem>
            </MudSelect>
        }
        else if (Model is TagCbntDescriptor cbd)
        {
            <MudText Typo="Typo.h6">编辑 TagCbnt</MudText>
            <MudTextField Label="Name" @bind-Value="cbd.Name" />
            <MudTextField Label="StartAddress" @bind-Value="cbd.StartAddress" />
            <MudNumericField T="int" Label="ScanInterval" @bind-Value="cbd.ScanInterval" />
            <MudSelect T="TagAccessMode" Label="Access" @bind-Value="cbd.AccessMode">
                <MudSelectItem Value="TagAccessMode.RW">RW</MudSelectItem>
                <MudSelectItem Value="TagAccessMode.RO">RO</MudSelectItem>
                <MudSelectItem Value="TagAccessMode.R1W">R1W</MudSelectItem>
            </MudSelect>
            <MudPaper Class="mt-4">
                <MudText Typo="Typo.subtitle1">Children</MudText>
                @foreach (var t in cbd.Children)
                {
                    <div style="display:flex; gap:8px; align-items:center; margin-top:4px;">
                        <MudText>@t.TagName</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="(() => RemoveChild(cbd, t))">删除</MudButton>
                    </div>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => AddChildToCbnt(cbd))">添加 Tag</MudButton>
            </MudPaper>
        }
        else if (Model is TagGrpDescriptor tgd)
        {
            <MudText Typo="Typo.h6">编辑 Group</MudText>
            <MudTextField Label="Name" @bind-Value="tgd.Name" />
            <MudTextField Label="Channel" @bind-Value="tgd.ChannelName" />
            <MudCheckBox T="bool" @bind-Checked="tgd.IsEntry" >IsEntry</MudCheckBox>
            <MudNumericField T="int" Label="ScanInterval" @bind-Value="tgd.ScanInterval" />
            <MudCheckBox T="bool" @bind-Checked="tgd.IsEnabled">IsEnabled</MudCheckBox>
            <MudPaper Class="mt-4">
                <MudText Typo="Typo.subtitle1">Children</MudText>
                @foreach (var child in tgd.Children)
                {
                    <div style="display:flex; gap:8px; align-items:center; margin-top:4px;">
                        @if(child is TagDescriptor d)
                        {
                        <MudText>@d.TagName</MudText>
                        }
                        else if (child is TagCbntDescriptor c)
                        {
                        <MudText>@c.Name</MudText>
                        }
                        else if (child is TagGrpDescriptor g)
                        {
                        <MudText>@g.Name</MudText>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="(() => RemoveChildFromGroup(tgd, child))">删除</MudButton>
                    </div>
                }
                <div style="display:flex; gap:8px; margin-top:8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => AddTagToGroup(tgd))">添加 Tag</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => AddCbntToGroup(tgd))">添加 TagCbnt</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => AddGroupToGroup(tgd))">添加 Group</MudButton>
                </div>
            </MudPaper>
        }
        <div style="margin-top:12px; display:flex; gap:8px; justify-content:flex-end;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">保存</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Cancel">取消</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public ITagsDescriptor? Model { get; set; }

    [Parameter]
    public EventCallback<ITagsDescriptor?> ModelChanged { get; set; }

    private void Save()
    {
        // Model is bound directly to descriptors, so nothing else to do
    }

    private void Cancel()
    {
        Model = null;
        ModelChanged.InvokeAsync(null);
    }

    private void RemoveChild(TagCbntDescriptor cbnt, TagDescriptor child)
    {
        cbnt.Children.Remove(child);
        StateHasChanged();
    }

    private void AddChildToCbnt(TagCbntDescriptor cbnt)
    {
        var t = new TagDescriptor { TagName = "NewTag", Address = "" };
        cbnt.Children.Add(t);
        StateHasChanged();
    }

    private void RemoveChildFromGroup(TagGrpDescriptor grp, ITagsDescriptor child)
    {
        grp.Children.Remove(child);
        StateHasChanged();
    }

    private void AddTagToGroup(TagGrpDescriptor grp)
    {
        grp.Children.Add(new TagDescriptor { TagName = "NewTag", Address = "" });
        StateHasChanged();
    }

    private void AddCbntToGroup(TagGrpDescriptor grp)
    {
        grp.Children.Add(new TagCbntDescriptor { Name = "NewCbnt", StartAddress = "" });
        StateHasChanged();
    }

    private void AddGroupToGroup(TagGrpDescriptor grp)
    {
        grp.Children.Add(new TagGrpDescriptor { Name = "NewGroup" });
        StateHasChanged();
    }
}
