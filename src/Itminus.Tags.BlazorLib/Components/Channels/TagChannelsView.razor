@using Itminus.Tags

@if (Descriptors is null || !Descriptors.Any())
{
    <MudText Class="pa-4" Color="Color.Secondary">(no channels)</MudText>
}
else
{
    <MudPaper Class="pa-2">
        <MudStack Spacing="1">
        @for (var i =0; i < _items.Count; i++)
        {
            var idx = i;
            <TagChannelItem Descriptor="_items[idx]" Editable="Editable" DescriptorChanged="(d => OnDescriptorChanged(idx, d))" />
        }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public IEnumerable<TagChannelDescriptor>? Descriptors { get; set; }
    [Parameter] public bool Editable { get; set; }

    private List<TagChannelDescriptor> _items = new();

    protected override void OnParametersSet()
    {
        _items = Descriptors?.ToList() ?? new();
    }

    private void OnDescriptorChanged(int index, TagChannelDescriptor newDescriptor)
    {
        if (index <0 || index >= _items.Count)
            return;

        _items[index] = newDescriptor;

        // If the incoming Descriptors is a mutable list, also replace it so outer components see the upgraded type.
        if (Descriptors is IList<TagChannelDescriptor> list)
        {
            list[index] = newDescriptor;
        }
    }
}
