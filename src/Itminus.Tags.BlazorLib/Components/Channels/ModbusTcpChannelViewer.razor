@using Itminus.Tags.ModbusTcp

<MudTreeViewItem T="ModbusTcpTagChannelDescriptor" Icon="Icons.Material.Filled.Info">
    <BodyContent>
        <div style="display: grid; grid-template-columns: 1fr auto; align-items: center; width: 100%">
            @ChannelDescriptor.Name @@ @ChannelDescriptor.Driver
            <div style="justify-self: end;">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Medium" Color="Color.Inherit" />
            </div>
        </div>
    </BodyContent>
    <ChildContent>
        <MudGrid Style="padding-left:20px">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Label="Name" Variant="Variant.Filled" @bind-Value="ChannelDescriptor.Name"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Label="IpAddr" Variant="Variant.Filled" @bind-Value="ChannelDescriptor.IpAddr"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudNumericField Label="Port" Variant="Variant.Filled" @bind-Value="ChannelDescriptor.Port"></MudNumericField>
            </MudItem>
        </MudGrid>



    </ChildContent>
</MudTreeViewItem>


@code {
    [Parameter]
    public ModbusTcpTagChannelDescriptor ChannelDescriptor { get; set; } = new ModbusTcpTagChannelDescriptor();
}
