<?xml version="1.0" encoding="utf-8"?>
<root>

	<!-- 通道，可以配置多个-->
	<Channel name="OpcUaClient-2" driver="OpcUaClient">
		<IpAddr>localhost</IpAddr>
		<Port>502</Port>
	</Channel>


	<!-- 测点配置，可以配置多个 -->

	<!-- ModbusTcp 配置 -->
	<TagGrp name="g4" isEntry="true" isEnabled="true" channel="OpcUaClient-2" scanInterval="10">
		<TagCbnt name="输入" access="RO">
			<Tag name="放行按钮闭合状态" address="nodeId11" ></Tag>
			<Tag name="手动" address="nodeId12"></Tag>
		</TagCbnt>
		<TagCbnt name="输出" >
			<Tag name="绿灯" address="nodeId01"></Tag>
			<Tag name="红灯" address="nodeId02"></Tag>
			<Tag name="黄灯" address="nodeId03"></Tag>
			<Tag name="放行灯" address="nodeId04"></Tag>
		</TagCbnt>
	</TagGrp>

	<!-- 逻辑配置，可以配置0~N个 -->
	<!--<Logicet>E:\SourceCode\揽月\Itminus.Tags\src\Samples.Plugin1\bin\Debug\net8.0\\Samples.Plugin1.dll</Logicet>-->
</root>